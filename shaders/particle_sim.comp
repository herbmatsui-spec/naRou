// Particle Simulation Compute Shader
// 1M particles, curl noise, SDF collision, life management

#version 450 core

layout(local_size_x = 256) in;

// Particle struct (matches CPU)
struct Particle {
    vec3 position;
    vec3 velocity;
    vec4 life;      // x=current, y=max, z=padding, w=padding
    vec4 color;     // rgba
    vec4 size;      // x=start, y=end, z=current, w=padding
    vec4 rotation;  // x=start, y=speed, z=current, w=padding
    uint flags;
    uint material_id;
    uint emitter_id;
    vec3 prev_position;
    float ribbon_length;
};

// SSBO
layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(std430, binding = 1) buffer AliveIndices {
    uint alive_indices[];
    uint alive_count;
};

layout(std430, binding = 2) buffer FreeList {
    uint free_list[];
    uint free_count;
};

layout(std430, binding = 3) buffer SDFGrid {
    float sdf[];
    ivec3 sdf_dims;
    vec3 sdf_bounds_min;
    vec3 sdf_bounds_max;
    float cell_size;
};

layout(std430, binding = 4) buffer CurlNoise {
    uint perm[];
};

uniform float u_dt;
uniform float u_time;
uniform vec3 u_gravity;
uniform vec3 u_wind;
uniform int u_max_particles;
uniform uint u_flags_curl_noise;
uniform uint u_flags_sdf_collision;
uniform uint u_flags_ribbon;

// Curl noise functions
float fade(float t) {
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

float lerp(float a, float b, float t) {
    return a + t * (b - a);
}

float grad(uint hash, float x, float y, float z) {
    uint h = hash & 15u;
    float u = h < 8u ? x : y;
    float v = h < 4u ? y : (h == 12u || h == 14u ? x : z);
    return ((h & 1u) == 0u ? u : -u) + ((h & 2u) == 0u ? v : -v);
}

float noise3d(vec3 p) {
    ivec3 ip = ivec3(floor(p)) & 255;
    vec3 fp = fract(p);
    vec3 f = fade(fp);
    
    uint aaa = perm[perm[perm[uint(ip.x)] + uint(ip.y)] + uint(ip.z)];
    uint aba = perm[perm[perm[uint(ip.x)] + uint(ip.y)] + uint(ip.z) + 1u];
    uint aab = perm[perm[perm[uint(ip.x)] + uint(ip.y) + 1u] + uint(ip.z)];
    uint abb = perm[perm[perm[uint(ip.x)] + uint(ip.y) + 1u] + uint(ip.z) + 1u];
    uint baa = perm[perm[perm[uint(ip.x) + 1u] + uint(ip.y)] + uint(ip.z)];
    uint bba = perm[perm[perm[uint(ip.x) + 1u] + uint(ip.y)] + uint(ip.z) + 1u];
    uint bab = perm[perm[perm[uint(ip.x) + 1u] + uint(ip.y) + 1u] + uint(ip.z)];
    uint bbb = perm[perm[perm[uint(ip.x) + 1u] + uint(ip.y) + 1u] + uint(ip.z) + 1u];
    
    float x1 = lerp(float(grad(aaa, fp.x, fp.y, fp.z)), 
                    float(grad(baa, fp.x - 1.0, fp.y, fp.z)), f.x);
    float x2 = lerp(float(grad(aba, fp.x, fp.y - 1.0, fp.z)), 
                    float(grad(bba, fp.x - 1.0, fp.y - 1.0, fp.z)), f.x);
    float y1 = lerp(x1, x2, f.y);
    
    x1 = lerp(float(grad(aab, fp.x, fp.y, fp.z - 1.0)), 
              float(grad(bab, fp.x - 1.0, fp.y, fp.z - 1.0)), f.x);
    x2 = lerp(float(grad(abb, fp.x, fp.y - 1.0, fp.z - 1.0)), 
              float(grad(bbb, fp.x - 1.0, fp.y - 1.0, fp.z - 1.0)), f.x);
    float y2 = lerp(x1, x2, f.y);
    
    return lerp(y1, y2, f.z) * 2.0;
}

vec3 curl_noise(vec3 p, float eps) {
    // Curl = ∇ × N
    float n_x = noise3d(p);
    float n_y = noise3d(p + vec3(1000.0, 0.0, 0.0));
    float n_z = noise3d(p + vec3(2000.0, 0.0, 0.0));
    
    float n_x_eps_y = noise3d(p + vec3(0.0, eps, 0.0));
    float n_y_eps_y = noise3d(p + vec3(1000.0, eps, 0.0));
    float n_z_eps_y = noise3d(p + vec3(2000.0, eps, 0.0));
    
    float n_x_eps_z = noise3d(p + vec3(0.0, 0.0, eps));
    float n_y_eps_z = noise3d(p + vec3(1000.0, 0.0, eps));
    float n_z_eps_z = noise3d(p + vec3(2000.0, 0.0, eps));
    
    float n_x_eps_x = noise3d(p + vec3(eps, 0.0, 0.0));
    float n_y_eps_x = noise3d(p + vec3(1000.0 + eps, 0.0, 0.0));
    float n_z_eps_x = noise3d(p + vec3(2000.0 + eps, 0.0, 0.0));
    
    vec3 dx = vec3(
        (noise3d(p + vec3(0.0, eps, 0.0)).z - noise3d(p).z) / eps - 
        (noise3d(p + vec3(0.0, 0.0, eps)).y - noise3d(p).y) / eps,
        (noise3d(p + vec3(0.0, 0.0, eps)).x - noise3d(p).x) / eps - 
        (noise3d(p + vec3(eps, 0.0, 0.0)).z - noise3d(p).z) / eps,
        (noise3d(p + vec3(eps, 0.0, 0.0)).y - noise3d(p).y) / eps - 
        (noise3d(p + vec3(0.0, eps, 0.0)).x - noise3d(p).x) / eps
    );
    
    return dx;
}

float sdf_query(vec3 pos) {
    if (sdf_dims.x == 0) return 1e6;
    
    vec3 local = (pos - sdf_bounds_min) / cell_size;
    if (any(lessThan(local, vec3(0.0))) || any(greaterThan(local, vec3(sdf_dims) - 1.0))) {
        return 1e6;
    }
    
    vec3 idx = floor(local);
    vec3 frac = fract(local);
    ivec3 i = ivec3(idx);
    
    // Clamp
    i = clamp(i, ivec3(0), sdf_dims - ivec3(2));
    
    // Trilinear
    float c000 = sdf[i.z * sdf_dims.y * sdf_dims.x + i.y * sdf_dims.x + i.x];
    float c100 = sdf[i.z * sdf_dims.y * sdf_dims.x + i.y * sdf_dims.x + i.x + 1];
    float c010 = sdf[(i.z) * sdf_dims.y * sdf_dims.x + (i.y + 1) * sdf_dims.x + i.x];
    float c110 = sdf[(i.z) * sdf_dims.y * sdf_dims.x + (i.y + 1) * sdf_dims.x + i.x + 1];
    float c001 = sdf[(i.z + 1) * sdf_dims.y * sdf_dims.x + i.y * sdf_dims.x + i.x];
    float c101 = sdf[(i.z + 1) * sdf_dims.y * sdf_dims.x + i.y * sdf_dims.x + i.x + 1];
    float c011 = sdf[(i.z + 1) * sdf_dims.y * sdf_dims.x + (i.y + 1) * sdf_dims.x + i.x];
    float c111 = sdf[(i.z + 1) * sdf_dims.y * sdf_dims.x + (i.y + 1) * sdf_dims.x + i.x + 1];
    
    vec3 f = fract(local);
    float c00 = mix(c000, c100, f.x);
    float c01 = mix(c010, c110, f.x);
    float c10 = mix(c001, c101, f.x);
    float c11 = mix(c011, c111, f.x);
    
    float c0 = mix(c00, c01, f.y);
    float c1 = mix(c10, c11, f.y);
    
    return mix(c0, c1, f.z);
}

vec3 sdf_gradient(vec3 pos, float eps) {
    float d = sdf_query(pos);
    return vec3(
        sdf_query(pos + vec3(eps, 0.0, 0.0)) - d,
        sdf_query(pos + vec3(0.0, eps, 0.0)) - d,
        sdf_query(pos + vec3(0.0, 0.0, eps)) - d
    ) / eps;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= u_max_particles) return;
    
    // Only process alive particles
    if ((particles[idx].flags & 1u) == 0u) return;
    
    // Update life
    particles[idx].life.x += u_dt;
    if (particles[idx].life.x >= particles[idx].life.y) {
        // Kill particle - add to free list
        uint free_idx = atomicAdd(free_list.free_count, 1u);
        if (free_idx < u_max_particles) {
            free_list.free_list[free_idx] = idx;
        }
        particles[idx].flags = 0u;
        return;
    }
    
    float life_ratio = particles[idx].life.x / particles[idx].life.y;
    
    // Velocity
    vec3 vel = particles[idx].velocity;
    
    // Gravity
    vel += u_gravity * u_dt;
    
    // Wind
    vel += u_wind * u_dt;
    
    // Curl noise
    if ((u_flags_curl_noise & 1u) != 0u) {
        vec3 noise_vel = curl_noise(particles[idx].position + u_time, 0.01);
        vel += noise_vel * u_dt * 5.0;
    }
    
    // Position update
    vec3 new_pos = particles[idx].position + vel * u_dt;
    
    // SDF Collision
    if ((u_flags_sdf_collision & 1u) != 0u) {
        float dist = sdf_query(new_pos);
        float radius = particles[idx].size.z;
        
        if (dist < radius) {
            vec3 grad = sdf_gradient(new_pos, 0.01);
            float grad_len = length(grad);
            if (grad_len > 1e-6) {
                grad = normalize(grad);
                new_pos += grad * (radius - dist);
                
                float v_dot_n = dot(vel, grad);
                if (v_dot_n < 0.0) {
                    vel -= grad * (1.0 + 0.3) * v_dot_n;
                }
            }
        }
    }
    
    // Ribbon/Trail
    if ((u_flags_ribbon & 1u) != 0u && (particles[idx].flags & 2u) != 0u) {
        particles[idx].prev_position = particles[idx].position;
        particles[idx].ribbon_length += length(new_pos - particles[idx].position);
    }
    
    // Rotation
    particles[idx].rotation.z += particles[idx].rotation.y * u_dt;
    
    // Size interpolation
    particles[idx].size.z = mix(particles[idx].size.x, particles[idx].size.y, life_ratio);
    
    // Alpha fade
    float life_ratio = particles[idx].life.x / particles[idx].life.y;
    particles[idx].color.w *= (1.0 - life_ratio);
    
    // Commit
    particles[idx].position = new_pos;
    particles[idx].velocity = vel;
}