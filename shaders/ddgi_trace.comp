vec3 reconstruct_position_from_depth(vec2 uv, float depth) {
    vec4 clip = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 view = u_inv_proj[0] * clip;  // Simplified
    return view.xyz / view.w;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    uint face = gl_GlobalInvocationID.z;
    
    if (pixel.x >= probe.atlas_resolution || pixel.y >= probe.atlas_resolution) return;
    if (face >= 6) return;
    
    // UV for this face
    vec2 uv = (vec2(pixel) + 0.5) / vec2(probe.atlas_resolution);
    
    // Ray direction for this face
    vec3 face_dirs[6] = vec3[6](
        vec3(1, 0, 0), vec3(-1, 0, 0),
        vec3(0, 1, 0), vec3(0, -1, 0),
        vec3(0, 0, 1), vec3(0, 0, -1)
    );
    
    vec3 ray_dir = face_dirs[face];
    
