    // Placeholder: output probe position as radiance
    vec2 radiance = vec2(length(probe.probe_position), float(probe.frame_index));
    float depth = 1.0;
    
    // Write to atlas
    // Layer = probe_index * 6 + face
    uint layer = probe.probe_index * 6 + face;
    imageStore(u_radiance_atlas, ivec3(pixel, int(layer)), vec4(radiance, 0.0, 1.0));
