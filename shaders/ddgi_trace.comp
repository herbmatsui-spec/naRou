uniform mat4 u_inv_proj[6];

// Output atlas (6 faces × resolution × resolution)
layout(rg16f, binding = 0) uniform image2DArray u_radiance_atlas;  // layer = probe*6 + face
layout(r16f, binding = 1) uniform image2DArray u_depth_atlas;

// Ray tracing
layout(set = 0, binding = 8) accelerationStructureEXT top_level_as;

const float PI = 3.14159265359;

vec3 reconstruct_position(vec2 uv, float depth, int face) {
    vec4 clip = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 view = u_inv_proj[face] * clip;
    view.xyz /= view.w;
    return view.xyz;
}

vec3 reconstruct_normal(vec2 packed_xy) {
    float x = packed_xy.x;
    float y = packed_xy.y;
    float z_sq = 1.0 - x * x - y * y;
    float z = sqrt(max(z_sq, 0.0));
    return normalize(vec3(x, y, z));
}

