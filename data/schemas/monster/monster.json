{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Monster Definition",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "一意のモンスターID (mn_ プレフィックス推奨)",
      "pattern": "^mn_[a-z_][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "表示名 (日本語)"
    },
    "description": {
      "type": "string",
      "description": "フレーバーテキスト"
    },
    "char": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2,
      "description": "表示文字"
    },
    "color": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0, "maximum": 255},
      "minItems": 3,
      "maxItems": 3,
      "description": "RGB色"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "description": "モンスター レベル"
    },
    "speed": {
      "type": "integer",
      "minimum": 35,
      "maximum": 200,
      "default": 100,
      "description": "行動速度 (100 = 標準)"
    },
    "max_hp": {
      "type": "integer",
      "minimum": 1,
      "description": "最大HP"
    },
    "min_floor": {
      "type": "integer",
      "minimum": 1,
      "description": "出現最小階層"
    },
    "max_floor": {
      "type": "integer",
      "minimum": 1,
      "description": "出現最大階層"
    },
    "melee_damage": {
      "type": "string",
      "pattern": "^\\d+d\\d+(\\+\\d+)?$",
      "description": "近接ダメージ ダイス記法 (例: '2d6+3')"
    },
    "hit_bonus": {
      "type": "integer",
      "default": 0,
      "description": "命中ボーナス"
    },
    "pv": {
      "type": "integer",
      "default": 0,
      "description": "Protection Value (防御値)"
    },
    "dv": {
      "type": "integer",
      "default": 0,
      "description": "Dodge Value (回避値)"
    },
    "abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "cost", "cooldown", "range", "target_type", "effect", "ai_hint"],
        "properties": {
          "id": {"type": "string", "description": "能力ID"},
          "name": {"type": "string", "description": "表示名"},
          "description": {"type": "string", "description": "説明"},
          "cost": {"type": "integer", "minimum": 0, "description": "APコスト"},
          "cooldown": {"type": "integer", "minimum": 0, "description": "クールダウン(ターン)"},
          "range": {"type": "integer", "minimum": 0, "description": "射程"},
          "radius": {"type": "integer", "minimum": 0, "default": 0, "description": "範囲半径"},
          "target_type": {"type": "string", "enum": ["single", "area", "self", "beam"]},
          "effect": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {"type": "string", "enum": ["damage", "heal", "buff", "status", "drain", "steal", "summon"]},
              "element": {"type": "string"},
              "dice_num": {"type": "integer", "minimum": 1, "default": 1},
              "dice_side": {"type": "integer", "minimum": 2, "default": 6},
              "dmg_bonus": {"type": "integer", "default": 0},
              "condition": {"type": "string"},
              "stat": {"type": "string"},
              "amount": {"type": "integer"},
              "duration": {"type": "integer"},
              "power": {"type": "integer"},
              "status_type": {"type": "string", "enum": ["poison", "paralysis", "knockback", "bleeding", "blind", "confusion"]},
              "resource": {"type": "string", "enum": ["mp", "gold"]},
              "amount_per_level": {"type": "integer"},
              "monster_id": {"type": "string"},
              "count": {"type": "integer", "default": 1}
            }
          }
        },
        "sound": {"type": "string"},
        "ai_hint": {"type": "string", "enum": ["ranged", "melee", "heal", "support", "utility", "debuff", "summon"]}
      },
      "required": ["id", "name", "cost", "cooldown", "range", "target_type", "effect", "ai_hint"],
      "additionalProperties": false
    }
  },
  "required": ["name", "char", "color", "max_hp", "min_floor", "max_floor", "ai_type"],
  "additionalProperties": false
}